{
    "native": [
        "using System;",
        "using System.Collections.Generic;",
        "using System.ComponentModel;",
        "using System.Runtime.InteropServices;",
        "",
        "public sealed class PylanceOwnedWindowsProcess : IDisposable",
        "{",
        "    private const uint QueryAccess = 0x1000 | 0x100000;",
        "    private const uint ControlAccess = QueryAccess | 0x0001 | 0x0800;",
        "    private const int ProcessIsTerminating = unchecked((int)0xC000010A);",
        "    private IntPtr handle;",
        "    private bool controlled;",
        "    private bool suspended;",
        "    public readonly int Id;",
        "    public readonly int ParentId;",
        "    public readonly long CreationTimeUtcTicks;",
        "",
        "    [StructLayout(LayoutKind.Sequential)]",
        "    private struct BasicInformation",
        "    {",
        "        public IntPtr Reserved1, PebAddress, Reserved2, Reserved3;",
        "        public UIntPtr ProcessId, ParentProcessId;",
        "    }",
        "",
        "    [StructLayout(LayoutKind.Sequential)]",
        "    private struct UnicodeString",
        "    {",
        "        public ushort Length, MaximumLength;",
        "        public IntPtr Buffer;",
        "    }",
        "",
        "    // SYSTEM_PROCESS_INFORMATION prefix through InheritedFromUniqueProcessId.",
        "    [StructLayout(LayoutKind.Sequential)]",
        "    private struct SnapshotEntry",
        "    {",
        "        public uint NextEntryOffset, NumberOfThreads;",
        "        public long WorkingSetPrivateSize;",
        "        public uint HardFaultCount, NumberOfThreadsHighWatermark;",
        "        public ulong CycleTime;",
        "        public long CreateTime, UserTime, KernelTime;",
        "        public UnicodeString ImageName;",
        "        public int BasePriority;",
        "        public IntPtr ProcessId, ParentProcessId;",
        "    }",
        "",
        "    public sealed class Entry",
        "    {",
        "        public int Id;",
        "        public int ParentId;",
        "        public long CreationTimeUtcTicks;",
        "    }",
        "",
        "    public sealed class CandidateOpenException : Win32Exception",
        "    {",
        "        public readonly int ProcessId;",
        "",
        "        public CandidateOpenException(int error, int processId)",
        "            : base(error, \"Cannot pin candidate process \" + processId + \" (Win32 error \" + error + \": \" + new Win32Exception(error).Message + \")\")",
        "        {",
        "            ProcessId = processId;",
        "        }",
        "    }",
        "",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern IntPtr OpenProcess(uint access, bool inherit, int pid);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern bool CloseHandle(IntPtr value);",
        "    [DllImport(\"kernel32.dll\")]",
        "    private static extern IntPtr GetCurrentProcess();",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern bool DuplicateHandle(IntPtr sourceProcess, IntPtr source, IntPtr targetProcess, out IntPtr target, uint access, bool inherit, uint options);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern uint GetProcessId(IntPtr process);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern bool GetProcessTimes(IntPtr process, out long created, out long exited, out long kernel, out long user);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern uint WaitForSingleObject(IntPtr value, uint milliseconds);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern bool TerminateProcess(IntPtr process, uint code);",
        "    [DllImport(\"ntdll.dll\")]",
        "    private static extern int NtQuerySystemInformation(int kind, IntPtr information, int size, out int returned);",
        "    [DllImport(\"ntdll.dll\")]",
        "    private static extern int NtQueryInformationProcess(IntPtr process, int kind, out BasicInformation information, int size, out int returned);",
        "    [DllImport(\"ntdll.dll\")]",
        "    private static extern int NtSuspendProcess(IntPtr process);",
        "    [DllImport(\"ntdll.dll\")]",
        "    private static extern int NtResumeProcess(IntPtr process);",
        "",
        "    private PylanceOwnedWindowsProcess(IntPtr value)",
        "    {",
        "        handle = value;",
        "        try",
        "        {",
        "            Id = checked((int)GetProcessId(handle));",
        "            if (Id == 0) throw new Win32Exception();",
        "            BasicInformation information;",
        "            int returned;",
        "            CheckStatus(NtQueryInformationProcess(handle, 0, out information, Marshal.SizeOf(typeof(BasicInformation)), out returned), \"query parent identity\");",
        "            if (information.ProcessId.ToUInt64() != (ulong)Id) throw new InvalidOperationException(\"Native process identity changed.\");",
        "            ParentId = checked((int)information.ParentProcessId.ToUInt64());",
        "            CreationTimeUtcTicks = ReadTime(handle, false);",
        "        }",
        "        catch { Dispose(); throw; }",
        "    }",
        "",
        "    public static PylanceOwnedWindowsProcess Open(int pid)",
        "    {",
        "        IntPtr value = OpenProcess(QueryAccess, false, pid);",
        "        if (value == IntPtr.Zero)",
        "        {",
        "            int error = Marshal.GetLastWin32Error();",
        "            throw new CandidateOpenException(error, pid);",
        "        }",
        "        return new PylanceOwnedWindowsProcess(value);",
        "    }",
        "",
        "    public static PylanceOwnedWindowsProcess FromHandle(IntPtr ownedHandle)",
        "    {",
        "        IntPtr copy;",
        "        if (!DuplicateHandle(GetCurrentProcess(), ownedHandle, GetCurrentProcess(), out copy, 0, false, 2)) throw new Win32Exception();",
        "        return new PylanceOwnedWindowsProcess(copy);",
        "    }",
        "",
        "    public PylanceOwnedWindowsProcess Retain() { return FromHandle(handle); }",
        "    public long ExitTimeUtcTicks { get { return ReadTime(handle, true); } }",
        "    public bool HasExited { get { return WaitForExit(0); } }",
        "",
        "    private static long ReadTime(IntPtr process, bool exit)",
        "    {",
        "        long created, exited, kernel, user;",
        "        if (!GetProcessTimes(process, out created, out exited, out kernel, out user)) throw new Win32Exception();",
        "        long value = exit ? exited : created;",
        "        return value == 0 ? 0 : DateTime.FromFileTimeUtc(value).Ticks;",
        "    }",
        "",
        "    private void AcquireControl()",
        "    {",
        "        if (controlled) return;",
        "        // The query handle remains open during this access upgrade; never reopen a freed PID.",
        "        IntPtr value = OpenProcess(ControlAccess, false, Id);",
        "        if (value == IntPtr.Zero) throw new Win32Exception(Marshal.GetLastWin32Error(), \"Cannot control owned process \" + Id);",
        "        try",
        "        {",
        "            if (GetProcessId(value) != (uint)Id || ReadTime(value, false) != CreationTimeUtcTicks)",
        "                throw new InvalidOperationException(\"Owned process identity changed during access upgrade.\");",
        "            CloseHandle(handle);",
        "            handle = value;",
        "            value = IntPtr.Zero;",
        "            controlled = true;",
        "        }",
        "        finally { if (value != IntPtr.Zero) CloseHandle(value); }",
        "    }",
        "",
        "    public enum SuspendResult { AlreadyExited, Suspended, ExitedDuringSuspend }",
        "",
        "    public SuspendResult Suspend(int terminatingWaitMilliseconds)",
        "    {",
        "        if (HasExited) return SuspendResult.AlreadyExited;",
        "        AcquireControl();",
        "        int status = NtSuspendProcess(handle);",
        "        if (status == ProcessIsTerminating)",
        "        {",
        "            if (!WaitForExit(terminatingWaitMilliseconds))",
        "                throw new InvalidOperationException(\"Owned process \" + Id + \" is terminating but has not exited; cleanup is incomplete.\");",
        "            return SuspendResult.ExitedDuringSuspend;",
        "        }",
        "        CheckStatus(status, \"suspend owned process \" + Id);",
        "        suspended = true;",
        "        return SuspendResult.Suspended;",
        "    }",
        "",
        "    public void Resume()",
        "    {",
        "        if (!suspended) return;",
        "        if (!HasExited) CheckStatus(NtResumeProcess(handle), \"resume owned process \" + Id);",
        "        suspended = false;",
        "    }",
        "",
        "    public void Terminate()",
        "    {",
        "        if (HasExited) return;",
        "        AcquireControl();",
        "        if (!TerminateProcess(handle, 1)) throw new Win32Exception(Marshal.GetLastWin32Error(), \"Cannot terminate owned process \" + Id);",
        "    }",
        "",
        "    public bool WaitForExit(int milliseconds)",
        "    {",
        "        uint result = WaitForSingleObject(handle, checked((uint)milliseconds));",
        "        if (result == 0) return true;",
        "        if (result == 258) return false;",
        "        throw new Win32Exception(Marshal.GetLastWin32Error(), \"Cannot observe owned process exit.\");",
        "    }",
        "",
        "    public static Entry[] Snapshot()",
        "    {",
        "        // Birth times must be available even for protected processes we cannot open.",
        "        int capacity = 65536;",
        "        for (int attempt = 0; attempt < 8; attempt++)",
        "        {",
        "            if (capacity > 64 * 1024 * 1024) throw new InvalidOperationException(\"Process snapshot exceeds its memory budget.\");",
        "            IntPtr buffer = Marshal.AllocHGlobal(capacity);",
        "            try",
        "            {",
        "                int returned;",
        "                int status = NtQuerySystemInformation(5, buffer, capacity, out returned);",
        "                if (status == unchecked((int)0xC0000004))",
        "                {",
        "                    capacity = Math.Max(capacity * 2, returned);",
        "                    continue;",
        "                }",
        "                CheckStatus(status, \"snapshot process identities\");",
        "                if (returned <= 0 || returned > capacity) throw new InvalidOperationException(\"Invalid process snapshot length.\");",
        "                return ReadSnapshot(buffer, returned);",
        "            }",
        "            finally { Marshal.FreeHGlobal(buffer); }",
        "        }",
        "        throw new InvalidOperationException(\"Process snapshot exceeded its retry budget.\");",
        "    }",
        "",
        "    private static Entry[] ReadSnapshot(IntPtr buffer, int length)",
        "    {",
        "        List<Entry> entries = new List<Entry>();",
        "        int entrySize = Marshal.SizeOf(typeof(SnapshotEntry));",
        "        int offset = 0;",
        "        for (;;)",
        "        {",
        "            if (length - offset < entrySize) throw new InvalidOperationException(\"Truncated process snapshot entry.\");",
        "            SnapshotEntry entry = (SnapshotEntry)Marshal.PtrToStructure(IntPtr.Add(buffer, offset), typeof(SnapshotEntry));",
        "            entries.Add(new Entry {",
        "                Id = checked((int)entry.ProcessId.ToInt64()),",
        "                ParentId = checked((int)entry.ParentProcessId.ToInt64()),",
        "                CreationTimeUtcTicks = entry.CreateTime > 0 ? DateTime.FromFileTimeUtc(entry.CreateTime).Ticks : 0",
        "            });",
        "            if (entry.NextEntryOffset == 0) return entries.ToArray();",
        "            if (entry.NextEntryOffset < entrySize || entry.NextEntryOffset > length - offset - entrySize)",
        "                throw new InvalidOperationException(\"Invalid process snapshot entry offset.\");",
        "            offset += (int)entry.NextEntryOffset;",
        "        }",
        "    }",
        "",
        "    private static void CheckStatus(int status, string operation)",
        "    {",
        "        if (status < 0) throw new InvalidOperationException(\"Cannot \" + operation + \" (NTSTATUS 0x\" + status.ToString(\"X8\") + \").\");",
        "    }",
        "",
        "    public void Dispose()",
        "    {",
        "        if (handle != IntPtr.Zero) { CloseHandle(handle); handle = IntPtr.Zero; }",
        "    }",
        "}"
    ],
    "functions": [
        "function New-OwnedWindowsProcessLineageDiagnostics {",
        "    param(",
        "        [Parameter(Mandatory = $true)] [hashtable] $Known,",
        "        [Parameter(Mandatory = $true)] [object[]] $Hints,",
        "        [Parameter(Mandatory = $true)] $Parent,",
        "        [Parameter(Mandatory = $true)] [int] $Round,",
        "        [Parameter(Mandatory = $true)] [int] $HintIndex,",
        "        [Parameter(Mandatory = $true)] [int] $HintId,",
        "        [Parameter(Mandatory = $true)] [int] $HintParentId,",
        "        [Parameter(Mandatory = $true)] [long] $HintBirth,",
        "        [Parameter(Mandatory = $true)] [string] $Identity",
        "    )",
        "    $parentMatches = [System.Collections.Generic.List[object]]::new()",
        "    $parentMatchesTruncated = $false",
        "    for ($index = 0; $index -lt $Hints.Count; $index++) {",
        "        $entry = $Hints[$index]",
        "        if ([int]$entry.Id -ne $HintParentId) { continue }",
        "        if ($parentMatches.Count -ge 4) { $parentMatchesTruncated = $true; continue }",
        "        $parentMatches.Add([ordered]@{",
        "            snapshotIndex = $index",
        "            processId = [string][int]$entry.Id",
        "            parentProcessId = [string][int]$entry.ParentId",
        "            creationTimeUtcTicks = [string][long]$entry.CreationTimeUtcTicks",
        "        })",
        "    }",
        "    $chain = [System.Collections.Generic.List[object]]::new()",
        "    $cursor = $Parent",
        "    for ($depth = 0; $null -ne $cursor -and $depth -lt 16; $depth++) {",
        "        $chain.Add([ordered]@{",
        "            processId = [string][int]$cursor.Id",
        "            parentProcessId = [string][int]$cursor.ParentId",
        "            creationTimeUtcTicks = [string][long]$cursor.CreationTimeUtcTicks",
        "            acceptedSnapshotGeneration = [int]$cursor.SnapshotGeneration",
        "            acceptedSnapshotIndex = [int]$cursor.SnapshotIndex",
        "            nativeOpenOutcome = [string]$cursor.OpenOutcome",
        "        })",
        "        if (!$Known.ContainsKey([int]$cursor.ParentId)) { $cursor = $null; break }",
        "        $cursor = $Known[[int]$cursor.ParentId]",
        "    }",
        "    $chainTruncated = $null -ne $cursor",
        "    $root = @($Known.Values | Where-Object { $_.Depth -eq 0 })[0]",
        "    $generationMatches = $Parent.SnapshotGeneration -eq $Round",
        "    $frozenChildIdentityPresent = $Parent.AllowedChildren.ContainsKey($Identity)",
        "    $exactParentIdentityPresent = $false",
        "    foreach ($match in $parentMatches) {",
        "        if ($match.creationTimeUtcTicks -eq [string][long]$Parent.CreationTimeUtcTicks) {",
        "            $exactParentIdentityPresent = $true",
        "            break",
        "        }",
        "    }",
        "    $diagnostics = [ordered]@{",
        "        version = 1",
        "        root = [ordered]@{",
        "            processId = [string][int]$root.Id",
        "            creationTimeUtcTicks = [string][long]$root.CreationTimeUtcTicks",
        "        }",
        "        rejectedHint = [ordered]@{",
        "            processId = [string]$HintId",
        "            parentProcessId = [string]$HintParentId",
        "            creationTimeUtcTicks = [string]$HintBirth",
        "            snapshotGeneration = $Round",
        "            snapshotIndex = $HintIndex",
        "            nativeOpenOutcome = 'not-attempted-lineage-guard'",
        "        }",
        "        vanishedParent = [ordered]@{",
        "            processId = [string][int]$Parent.Id",
        "            parentProcessId = [string][int]$Parent.ParentId",
        "            creationTimeUtcTicks = [string][long]$Parent.CreationTimeUtcTicks",
        "            acceptedSnapshotGeneration = [int]$Parent.SnapshotGeneration",
        "            acceptedSnapshotIndex = [int]$Parent.SnapshotIndex",
        "            nativeOpenOutcome = [string]$Parent.OpenOutcome",
        "        }",
        "        currentSnapshot = [ordered]@{",
        "            generation = $Round",
        "            entryCount = $Hints.Count",
        "            exactVanishedParentIdentityPresent = $exactParentIdentityPresent",
        "            vanishedParentPidMatches = @($parentMatches.ToArray())",
        "            vanishedParentPidMatchesTruncated = $parentMatchesTruncated",
        "        }",
        "        failedOwnershipPredicate = [ordered]@{",
        "            expression = 'parentSnapshotGenerationMatches && frozenChildIdentityPresent'",
        "            parentSnapshotGenerationMatches = $generationMatches",
        "            frozenChildIdentityPresent = $frozenChildIdentityPresent",
        "            rejectedIdentity = $Identity",
        "        }",
        "        parentChainOrder = 'vanished-parent-to-root'",
        "        parentChain = @($chain.ToArray())",
        "        parentChainTruncated = $chainTruncated",
        "    }",
        "    $json = ConvertTo-Json -InputObject $diagnostics -Compress -Depth 6",
        "    return $json",
        "}",
        "",
        "function Stop-OwnedWindowsProcessTree {",
        "    param(",
        "        [Parameter(Mandatory = $true)] $Root,",
        "        [ValidateRange(1, 60000)] [int] $TimeoutMilliseconds = 5000,",
        "        [scriptblock] $Snapshot = { [PylanceOwnedWindowsProcess]::Snapshot() },",
        "        [scriptblock] $OpenProcess = { param([int] $ProcessId) [PylanceOwnedWindowsProcess]::Open($ProcessId) }",
        "    )",
        "    $watch = [System.Diagnostics.Stopwatch]::StartNew()",
        "    $held = [System.Collections.Generic.List[object]]::new()",
        "    $known = @{}",
        "    $failure = $null",
        "    $cleanupErrors = [System.Collections.Generic.List[string]]::new()",
        "    try {",
        "        if ($Root.Id -eq $PID) { throw 'Refusing to terminate the cleanup process.' }",
        "        $retainedRoot = $Root.Retain()",
        "        $rootEntry = [PSCustomObject]@{",
        "            Process = $retainedRoot",
        "            Id = [int]$retainedRoot.Id",
        "            CreationTimeUtcTicks = [long]$retainedRoot.CreationTimeUtcTicks",
        "            Depth = 0",
        "            ParentId = [int]$retainedRoot.ParentId",
        "            SnapshotGeneration = -1",
        "            SnapshotIndex = -1",
        "            OpenOutcome = 'retained-root'",
        "            AllowedChildren = $null",
        "        }",
        "        $held.Add($rootEntry)",
        "        $known[[int]$retainedRoot.Id] = $rootEntry",
        "        $remaining = [Math]::Max(1, $TimeoutMilliseconds - [int]$watch.ElapsedMilliseconds)",
        "        $null = $retainedRoot.Suspend($remaining)",
        "        for ($round = 0; ; $round++) {",
        "            if ($round -ge 64 -or $known.Count -gt 4096 -or $watch.ElapsedMilliseconds -ge $TimeoutMilliseconds) {",
        "                throw 'Owned process-tree discovery exceeded its bounded budget; cleanup is incomplete.'",
        "            }",
        "            $hints = @(& $Snapshot)",
        "            $found = $false",
        "            $madeProgress = $true",
        "            while ($madeProgress) {",
        "                $madeProgress = $false",
        "                $hintIndex = 0",
        "                foreach ($hint in $hints) {",
        "                    $currentHintIndex = $hintIndex",
        "                    $hintIndex++",
        "                    $hintId = [int]$hint.Id",
        "                    $hintParentId = [int]$hint.ParentId",
        "                    $hintBirth = [long]$hint.CreationTimeUtcTicks",
        "                    if ($known.ContainsKey($hintId)) {",
        "                        $existing = $known[$hintId]",
        "                        if ($null -eq $existing.Process -and $hintBirth -gt 0 -and $hintBirth -ne $existing.CreationTimeUtcTicks) {",
        "                            throw \"Vanished process $hintId was reused during discovery; cleanup is incomplete.\"",
        "                        }",
        "                        continue",
        "                    }",
        "                    if (!$known.ContainsKey($hintParentId)) { continue }",
        "                    if ($watch.ElapsedMilliseconds -ge $TimeoutMilliseconds) { throw 'Owned process-tree discovery timed out; cleanup is incomplete.' }",
        "                    $parent = $known[$hintParentId]",
        "                    if ($null -eq $parent.Process) {",
        "                        $identity = \"$hintId`:$hintBirth\"",
        "                        if ($parent.SnapshotGeneration -ne $round -or !$parent.AllowedChildren.ContainsKey($identity)) {",
        "                            $lineageMessage = \"Cannot prove ownership of process $hintId through vanished parent $hintParentId; cleanup is incomplete.\"",
        "                            try {",
        "                                $lineageDiagnostics = New-OwnedWindowsProcessLineageDiagnostics -Known $known -Hints $hints -Parent $parent -Round $round -HintIndex $currentHintIndex -HintId $hintId -HintParentId $hintParentId -HintBirth $hintBirth -Identity $identity",
        "                                [Console]::Error.WriteLine(\"OWNED_PROCESS_LINEAGE_DIAGNOSTICS $lineageDiagnostics\")",
        "                                $lineageMessage += \" Ownership diagnostics: $lineageDiagnostics\"",
        "                            } catch {",
        "                                $lineageMessage += \" Ownership diagnostic capture failed: $($_.Exception.Message)\"",
        "                            }",
        "                            throw $lineageMessage",
        "                        }",
        "                    }",
        "                    # Exclude historical PID reuse before opening potentially inaccessible processes.",
        "                    if ($hintBirth -gt 0 -and $hintBirth -lt $parent.CreationTimeUtcTicks) { continue }",
        "                    $candidate = $null",
        "                    try {",
        "                        try { $candidate = & $OpenProcess $hintId }",
        "                        catch {",
        "                            $openFailure = $_.Exception",
        "                            while ($openFailure.InnerException) { $openFailure = $openFailure.InnerException }",
        "                            if ($openFailure -isnot [PylanceOwnedWindowsProcess+CandidateOpenException] -or",
        "                                $openFailure.NativeErrorCode -ne 87 -or $openFailure.ProcessId -ne $hintId) {",
        "                                throw",
        "                            }",
        "                            if ($hintId -le 0 -or $hintBirth -le 0) {",
        "                                throw \"Cannot prove the identity of vanished process $hintId; cleanup is incomplete.\"",
        "                            }",
        "                            if ($hintBirth -lt $parent.CreationTimeUtcTicks) { continue }",
        "                            if ($hintBirth -eq $parent.CreationTimeUtcTicks) {",
        "                                throw \"Ambiguous parent/child birth ordering for $hintId; cleanup is incomplete.\"",
        "                            }",
        "                            if ($null -ne $parent.Process) {",
        "                                $parentExit = $parent.Process.ExitTimeUtcTicks",
        "                                if ($parentExit -ne 0 -and $hintBirth -gt $parentExit) { continue }",
        "                            }",
        "                            if ($hintId -eq $PID) { throw 'Refusing to include the cleanup process in the owned tree.' }",
        "                            $allowedChildren = @{}",
        "                            foreach ($childHint in $hints) {",
        "                                $childId = [int]$childHint.Id",
        "                                $childBirth = [long]$childHint.CreationTimeUtcTicks",
        "                                if ([int]$childHint.ParentId -eq $hintId -and $childBirth -gt $hintBirth) {",
        "                                    $allowedChildren[\"$childId`:$childBirth\"] = $true",
        "                                }",
        "                            }",
        "                            $entry = [PSCustomObject]@{",
        "                                Process = $null",
        "                                Id = $hintId",
        "                                CreationTimeUtcTicks = $hintBirth",
        "                                Depth = $parent.Depth + 1",
        "                                ParentId = $hintParentId",
        "                                SnapshotGeneration = $round",
        "                                SnapshotIndex = $currentHintIndex",
        "                                OpenOutcome = 'candidate-open-error-87'",
        "                                AllowedChildren = $allowedChildren",
        "                            }",
        "                            $known[$hintId] = $entry",
        "                            $found = $true",
        "                            $madeProgress = $true",
        "                            continue",
        "                        }",
        "                        if ($null -eq $candidate) { throw \"Cannot pin candidate process $hintId; cleanup is incomplete.\" }",
        "                        if ($candidate.Id -ne $hintId) { throw 'Pinned candidate identity does not match the snapshot.' }",
        "                        # A pinned identity must match the exact native snapshot generation.",
        "                        if ($hintBirth -gt 0 -and $candidate.CreationTimeUtcTicks -ne $hintBirth) {",
        "                            throw \"Pinned candidate birth does not match the snapshot for $hintId; cleanup is incomplete.\"",
        "                        }",
        "                        if ($candidate.ParentId -ne $parent.Id) { continue }",
        "                        if ($candidate.CreationTimeUtcTicks -lt $parent.CreationTimeUtcTicks) { continue }",
        "                        if ($candidate.CreationTimeUtcTicks -eq $parent.CreationTimeUtcTicks) {",
        "                            throw \"Ambiguous parent/child birth ordering for $($candidate.Id); cleanup is incomplete.\"",
        "                        }",
        "                        if ($null -ne $parent.Process) {",
        "                            $parentExit = $parent.Process.ExitTimeUtcTicks",
        "                            if ($parentExit -ne 0 -and $candidate.CreationTimeUtcTicks -gt $parentExit) { continue }",
        "                        }",
        "                        if ($candidate.Id -eq $PID) { throw 'Refusing to include the cleanup process in the owned tree.' }",
        "                        # Freeze each accepted parent before its next child snapshot, not an entire discovered tree.",
        "                        $entry = [PSCustomObject]@{",
        "                            Process = $candidate",
        "                            Id = [int]$candidate.Id",
        "                            CreationTimeUtcTicks = [long]$candidate.CreationTimeUtcTicks",
        "                            Depth = $parent.Depth + 1",
        "                            ParentId = [int]$candidate.ParentId",
        "                            SnapshotGeneration = -1",
        "                            SnapshotIndex = $currentHintIndex",
        "                            OpenOutcome = 'pinned'",
        "                            AllowedChildren = $null",
        "                        }",
        "                        $held.Add($entry)",
        "                        $known[$hintId] = $entry",
        "                        $candidate = $null",
        "                        $remaining = [Math]::Max(1, $TimeoutMilliseconds - [int]$watch.ElapsedMilliseconds)",
        "                        $null = $entry.Process.Suspend($remaining)",
        "                        $found = $true",
        "                        $madeProgress = $true",
        "                    } finally {",
        "                        if ($null -ne $candidate) { $candidate.Dispose() }",
        "                    }",
        "                }",
        "            }",
        "            if (!$found) { break }",
        "        }",
        "        # Leave ancestors alive on failure so their owner can retain the root and retry cleanup.",
        "        foreach ($entry in ($held | Sort-Object -Property Depth -Descending)) {",
        "            $remaining = $TimeoutMilliseconds - [int]$watch.ElapsedMilliseconds",
        "            if ($remaining -le 0) { throw 'Owned process-tree termination timed out; cleanup is incomplete.' }",
        "            $entry.Process.Terminate()",
        "            if (!$entry.Process.WaitForExit($remaining)) { throw \"Owned process $($entry.Process.Id) has not exited; cleanup is incomplete.\" }",
        "        }",
        "    } catch {",
        "        $failure = $_",
        "    } finally {",
        "        for ($index = $held.Count - 1; $index -ge 0; $index--) {",
        "            $owned = $held[$index].Process",
        "            try { $owned.Resume() } catch { $cleanupErrors.Add([string]$_) }",
        "            try { $owned.Dispose() } catch { $cleanupErrors.Add([string]$_) }",
        "        }",
        "        $watch.Stop()",
        "    }",
        "    if ($cleanupErrors.Count -gt 0) { throw \"Owned process cleanup is incomplete: $failure; $($cleanupErrors -join '; ')\" }",
        "    if ($null -ne $failure) { throw $failure }",
        "}"
    ]
}

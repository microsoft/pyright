{
    "native": [
        "using System;",
        "using System.Collections.Generic;",
        "using System.ComponentModel;",
        "using System.Runtime.InteropServices;",
        "",
        "public sealed class PylanceOwnedWindowsProcess : IDisposable",
        "{",
        "    private const uint QueryAccess = 0x1000 | 0x100000;",
        "    private const uint ControlAccess = QueryAccess | 0x0001 | 0x0800;",
        "    private IntPtr handle;",
        "    private bool controlled;",
        "    private bool suspended;",
        "    public readonly int Id;",
        "    public readonly int ParentId;",
        "    public readonly long CreationTimeUtcTicks;",
        "",
        "    [StructLayout(LayoutKind.Sequential)]",
        "    private struct BasicInformation",
        "    {",
        "        public IntPtr Reserved1, PebAddress, Reserved2, Reserved3;",
        "        public UIntPtr ProcessId, ParentProcessId;",
        "    }",
        "",
        "    [StructLayout(LayoutKind.Sequential)]",
        "    private struct UnicodeString",
        "    {",
        "        public ushort Length, MaximumLength;",
        "        public IntPtr Buffer;",
        "    }",
        "",
        "    // SYSTEM_PROCESS_INFORMATION prefix through InheritedFromUniqueProcessId.",
        "    [StructLayout(LayoutKind.Sequential)]",
        "    private struct SnapshotEntry",
        "    {",
        "        public uint NextEntryOffset, NumberOfThreads;",
        "        public long WorkingSetPrivateSize;",
        "        public uint HardFaultCount, NumberOfThreadsHighWatermark;",
        "        public ulong CycleTime;",
        "        public long CreateTime, UserTime, KernelTime;",
        "        public UnicodeString ImageName;",
        "        public int BasePriority;",
        "        public IntPtr ProcessId, ParentProcessId;",
        "    }",
        "",
        "    public sealed class Entry",
        "    {",
        "        public int Id;",
        "        public int ParentId;",
        "        public long CreationTimeUtcTicks;",
        "    }",
        "",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern IntPtr OpenProcess(uint access, bool inherit, int pid);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern bool CloseHandle(IntPtr value);",
        "    [DllImport(\"kernel32.dll\")]",
        "    private static extern IntPtr GetCurrentProcess();",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern bool DuplicateHandle(IntPtr sourceProcess, IntPtr source, IntPtr targetProcess, out IntPtr target, uint access, bool inherit, uint options);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern uint GetProcessId(IntPtr process);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern bool GetProcessTimes(IntPtr process, out long created, out long exited, out long kernel, out long user);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern uint WaitForSingleObject(IntPtr value, uint milliseconds);",
        "    [DllImport(\"kernel32.dll\", SetLastError = true)]",
        "    private static extern bool TerminateProcess(IntPtr process, uint code);",
        "    [DllImport(\"ntdll.dll\")]",
        "    private static extern int NtQuerySystemInformation(int kind, IntPtr information, int size, out int returned);",
        "    [DllImport(\"ntdll.dll\")]",
        "    private static extern int NtQueryInformationProcess(IntPtr process, int kind, out BasicInformation information, int size, out int returned);",
        "    [DllImport(\"ntdll.dll\")]",
        "    private static extern int NtSuspendProcess(IntPtr process);",
        "    [DllImport(\"ntdll.dll\")]",
        "    private static extern int NtResumeProcess(IntPtr process);",
        "",
        "    private PylanceOwnedWindowsProcess(IntPtr value)",
        "    {",
        "        handle = value;",
        "        try",
        "        {",
        "            Id = checked((int)GetProcessId(handle));",
        "            if (Id == 0) throw new Win32Exception();",
        "            BasicInformation information;",
        "            int returned;",
        "            CheckStatus(NtQueryInformationProcess(handle, 0, out information, Marshal.SizeOf(typeof(BasicInformation)), out returned), \"query parent identity\");",
        "            if (information.ProcessId.ToUInt64() != (ulong)Id) throw new InvalidOperationException(\"Native process identity changed.\");",
        "            ParentId = checked((int)information.ParentProcessId.ToUInt64());",
        "            CreationTimeUtcTicks = ReadTime(handle, false);",
        "        }",
        "        catch { Dispose(); throw; }",
        "    }",
        "",
        "    public static PylanceOwnedWindowsProcess Open(int pid)",
        "    {",
        "        IntPtr value = OpenProcess(QueryAccess, false, pid);",
        "        if (value == IntPtr.Zero)",
        "        {",
        "            int error = Marshal.GetLastWin32Error();",
        "            throw new Win32Exception(error, \"Cannot pin candidate process \" + pid + \" (Win32 error \" + error + \": \" + new Win32Exception(error).Message + \")\");",
        "        }",
        "        return new PylanceOwnedWindowsProcess(value);",
        "    }",
        "",
        "    public static PylanceOwnedWindowsProcess FromHandle(IntPtr ownedHandle)",
        "    {",
        "        IntPtr copy;",
        "        if (!DuplicateHandle(GetCurrentProcess(), ownedHandle, GetCurrentProcess(), out copy, 0, false, 2)) throw new Win32Exception();",
        "        return new PylanceOwnedWindowsProcess(copy);",
        "    }",
        "",
        "    public PylanceOwnedWindowsProcess Retain() { return FromHandle(handle); }",
        "    public long ExitTimeUtcTicks { get { return ReadTime(handle, true); } }",
        "    public bool HasExited { get { return WaitForExit(0); } }",
        "",
        "    private static long ReadTime(IntPtr process, bool exit)",
        "    {",
        "        long created, exited, kernel, user;",
        "        if (!GetProcessTimes(process, out created, out exited, out kernel, out user)) throw new Win32Exception();",
        "        long value = exit ? exited : created;",
        "        return value == 0 ? 0 : DateTime.FromFileTimeUtc(value).Ticks;",
        "    }",
        "",
        "    private void AcquireControl()",
        "    {",
        "        if (controlled) return;",
        "        // The query handle remains open during this access upgrade; never reopen a freed PID.",
        "        IntPtr value = OpenProcess(ControlAccess, false, Id);",
        "        if (value == IntPtr.Zero) throw new Win32Exception(Marshal.GetLastWin32Error(), \"Cannot control owned process \" + Id);",
        "        try",
        "        {",
        "            if (GetProcessId(value) != (uint)Id || ReadTime(value, false) != CreationTimeUtcTicks)",
        "                throw new InvalidOperationException(\"Owned process identity changed during access upgrade.\");",
        "            CloseHandle(handle);",
        "            handle = value;",
        "            value = IntPtr.Zero;",
        "            controlled = true;",
        "        }",
        "        finally { if (value != IntPtr.Zero) CloseHandle(value); }",
        "    }",
        "",
        "    public void Suspend()",
        "    {",
        "        if (HasExited) return;",
        "        AcquireControl();",
        "        CheckStatus(NtSuspendProcess(handle), \"suspend owned process \" + Id);",
        "        suspended = true;",
        "    }",
        "",
        "    public void Resume()",
        "    {",
        "        if (!suspended) return;",
        "        if (!HasExited) CheckStatus(NtResumeProcess(handle), \"resume owned process \" + Id);",
        "        suspended = false;",
        "    }",
        "",
        "    public void Terminate()",
        "    {",
        "        if (HasExited) return;",
        "        AcquireControl();",
        "        if (!TerminateProcess(handle, 1)) throw new Win32Exception(Marshal.GetLastWin32Error(), \"Cannot terminate owned process \" + Id);",
        "    }",
        "",
        "    public bool WaitForExit(int milliseconds)",
        "    {",
        "        uint result = WaitForSingleObject(handle, checked((uint)milliseconds));",
        "        if (result == 0) return true;",
        "        if (result == 258) return false;",
        "        throw new Win32Exception(Marshal.GetLastWin32Error(), \"Cannot observe owned process exit.\");",
        "    }",
        "",
        "    public static Entry[] Snapshot()",
        "    {",
        "        // Birth times must be available even for protected processes we cannot open.",
        "        int capacity = 65536;",
        "        for (int attempt = 0; attempt < 8; attempt++)",
        "        {",
        "            if (capacity > 64 * 1024 * 1024) throw new InvalidOperationException(\"Process snapshot exceeds its memory budget.\");",
        "            IntPtr buffer = Marshal.AllocHGlobal(capacity);",
        "            try",
        "            {",
        "                int returned;",
        "                int status = NtQuerySystemInformation(5, buffer, capacity, out returned);",
        "                if (status == unchecked((int)0xC0000004))",
        "                {",
        "                    capacity = Math.Max(capacity * 2, returned);",
        "                    continue;",
        "                }",
        "                CheckStatus(status, \"snapshot process identities\");",
        "                if (returned <= 0 || returned > capacity) throw new InvalidOperationException(\"Invalid process snapshot length.\");",
        "                return ReadSnapshot(buffer, returned);",
        "            }",
        "            finally { Marshal.FreeHGlobal(buffer); }",
        "        }",
        "        throw new InvalidOperationException(\"Process snapshot exceeded its retry budget.\");",
        "    }",
        "",
        "    private static Entry[] ReadSnapshot(IntPtr buffer, int length)",
        "    {",
        "        List<Entry> entries = new List<Entry>();",
        "        int entrySize = Marshal.SizeOf(typeof(SnapshotEntry));",
        "        int offset = 0;",
        "        for (;;)",
        "        {",
        "            if (length - offset < entrySize) throw new InvalidOperationException(\"Truncated process snapshot entry.\");",
        "            SnapshotEntry entry = (SnapshotEntry)Marshal.PtrToStructure(IntPtr.Add(buffer, offset), typeof(SnapshotEntry));",
        "            entries.Add(new Entry {",
        "                Id = checked((int)entry.ProcessId.ToInt64()),",
        "                ParentId = checked((int)entry.ParentProcessId.ToInt64()),",
        "                CreationTimeUtcTicks = entry.CreateTime > 0 ? DateTime.FromFileTimeUtc(entry.CreateTime).Ticks : 0",
        "            });",
        "            if (entry.NextEntryOffset == 0) return entries.ToArray();",
        "            if (entry.NextEntryOffset < entrySize || entry.NextEntryOffset > length - offset - entrySize)",
        "                throw new InvalidOperationException(\"Invalid process snapshot entry offset.\");",
        "            offset += (int)entry.NextEntryOffset;",
        "        }",
        "    }",
        "",
        "    private static void CheckStatus(int status, string operation)",
        "    {",
        "        if (status < 0) throw new InvalidOperationException(\"Cannot \" + operation + \" (NTSTATUS 0x\" + status.ToString(\"X8\") + \").\");",
        "    }",
        "",
        "    public void Dispose()",
        "    {",
        "        if (handle != IntPtr.Zero) { CloseHandle(handle); handle = IntPtr.Zero; }",
        "    }",
        "}"
    ],
    "functions": [
        "function Stop-OwnedWindowsProcessTree {",
        "    param(",
        "        [Parameter(Mandatory = $true)] $Root,",
        "        [ValidateRange(1, 60000)] [int] $TimeoutMilliseconds = 5000,",
        "        [scriptblock] $Snapshot = { [PylanceOwnedWindowsProcess]::Snapshot() },",
        "        [scriptblock] $OpenProcess = { param([int] $ProcessId) [PylanceOwnedWindowsProcess]::Open($ProcessId) }",
        "    )",
        "    $watch = [System.Diagnostics.Stopwatch]::StartNew()",
        "    $held = [System.Collections.Generic.List[object]]::new()",
        "    $known = @{}",
        "    $failure = $null",
        "    $cleanupErrors = [System.Collections.Generic.List[string]]::new()",
        "    try {",
        "        if ($Root.Id -eq $PID) { throw 'Refusing to terminate the cleanup process.' }",
        "        $retainedRoot = $Root.Retain()",
        "        $rootEntry = [PSCustomObject]@{ Process = $retainedRoot; Depth = 0 }",
        "        $held.Add($rootEntry)",
        "        $known[[int]$retainedRoot.Id] = $rootEntry",
        "        $retainedRoot.Suspend()",
        "        for ($round = 0; ; $round++) {",
        "            if ($round -ge 64 -or $held.Count -gt 4096 -or $watch.ElapsedMilliseconds -ge $TimeoutMilliseconds) {",
        "                throw 'Owned process-tree discovery exceeded its bounded budget; cleanup is incomplete.'",
        "            }",
        "            $found = $false",
        "            foreach ($hint in (& $Snapshot)) {",
        "                if ($known.ContainsKey([int]$hint.Id) -or !$known.ContainsKey([int]$hint.ParentId)) { continue }",
        "                if ($watch.ElapsedMilliseconds -ge $TimeoutMilliseconds) { throw 'Owned process-tree discovery timed out; cleanup is incomplete.' }",
        "                $parent = $known[[int]$hint.ParentId]",
        "                # Exclude historical PID reuse before opening potentially inaccessible processes.",
        "                if ($hint.CreationTimeUtcTicks -gt 0 -and $hint.CreationTimeUtcTicks -lt $parent.Process.CreationTimeUtcTicks) { continue }",
        "                $candidate = & $OpenProcess ([int]$hint.Id)",
        "                if ($null -eq $candidate) { throw \"Cannot pin candidate process $($hint.Id); cleanup is incomplete.\" }",
        "                try {",
        "                    if ($candidate.Id -ne $hint.Id) { throw 'Pinned candidate identity does not match the snapshot.' }",
        "                    # A snapshot is only a hint; parent and birth must come from the pinned handle.",
        "                    if ($candidate.ParentId -ne $parent.Process.Id) { continue }",
        "                    if ($candidate.CreationTimeUtcTicks -lt $parent.Process.CreationTimeUtcTicks) { continue }",
        "                    if ($candidate.CreationTimeUtcTicks -eq $parent.Process.CreationTimeUtcTicks) {",
        "                        throw \"Ambiguous parent/child birth ordering for $($candidate.Id); cleanup is incomplete.\"",
        "                    }",
        "                    $parentExit = $parent.Process.ExitTimeUtcTicks",
        "                    if ($parentExit -ne 0 -and $candidate.CreationTimeUtcTicks -gt $parentExit) { continue }",
        "                    if ($candidate.Id -eq $PID) { throw 'Refusing to include the cleanup process in the owned tree.' }",
        "                    # Freeze each accepted parent before its next child snapshot, not an entire discovered tree.",
        "                    $entry = [PSCustomObject]@{ Process = $candidate; Depth = $parent.Depth + 1 }",
        "                    $held.Add($entry)",
        "                    $known[[int]$candidate.Id] = $entry",
        "                    $candidate = $null",
        "                    $entry.Process.Suspend()",
        "                    $found = $true",
        "                } finally {",
        "                    if ($null -ne $candidate) { $candidate.Dispose() }",
        "                }",
        "            }",
        "            if (!$found) { break }",
        "        }",
        "        # Leave ancestors alive on failure so their owner can retain the root and retry cleanup.",
        "        foreach ($entry in ($held | Sort-Object -Property Depth -Descending)) {",
        "            $remaining = $TimeoutMilliseconds - [int]$watch.ElapsedMilliseconds",
        "            if ($remaining -le 0) { throw 'Owned process-tree termination timed out; cleanup is incomplete.' }",
        "            $entry.Process.Terminate()",
        "            if (!$entry.Process.WaitForExit($remaining)) { throw \"Owned process $($entry.Process.Id) has not exited; cleanup is incomplete.\" }",
        "        }",
        "    } catch {",
        "        $failure = $_",
        "    } finally {",
        "        for ($index = $held.Count - 1; $index -ge 0; $index--) {",
        "            $owned = $held[$index].Process",
        "            try { $owned.Resume() } catch { $cleanupErrors.Add([string]$_) }",
        "            try { $owned.Dispose() } catch { $cleanupErrors.Add([string]$_) }",
        "        }",
        "        $watch.Stop()",
        "    }",
        "    if ($cleanupErrors.Count -gt 0) { throw \"Owned process cleanup is incomplete: $failure; $($cleanupErrors -join '; ')\" }",
        "    if ($null -ne $failure) { throw $failure }",
        "}"
    ]
}

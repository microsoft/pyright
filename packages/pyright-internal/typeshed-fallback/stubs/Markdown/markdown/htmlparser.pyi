import html.parser as htmlparser
import re
from collections.abc import Sequence
from typing import Final

from markdown import Markdown

commentclose: Final[re.Pattern[str]]
blank_line_re: Final[re.Pattern[str]]
inner_blank_line_re: Final[re.Pattern[str]]
void_tags: Final[frozenset[str]]

class HTMLExtractor(htmlparser.HTMLParser):
    empty_tags: set[str]
    lineno_start_cache: list[int]
    md: Markdown

    # Set by reset().
    inraw: bool
    intail: bool
    stack: list[str]
    inline_stack: list[str]
    cleandoc: list[str]

    def __init__(self, md: Markdown, *, convert_charrefs=False, scripting=False) -> None: ...
    @property
    def line_offset(self) -> int: ...
    def at_line_start(self) -> bool: ...
    def get_endtag_text(self, tag: str) -> str: ...
    def handle_starttag(self, tag: str, attrs: Sequence[tuple[str, str]]) -> None: ...  # type: ignore[override]
    def open_inline_tag(self, tag: str) -> None: ...
    def close_inline_tag(self, tag: str) -> None: ...
    def inline_close_follows(self, text: str) -> bool: ...
    def handle_empty_tag(self, data: str, is_block: bool) -> None: ...
    def handle_decl(self, data: str) -> None: ...
    def unknown_decl(self, data: str) -> None: ...
    def parse_bogus_comment(self, i: int, report: int = 0) -> int: ...
    def get_starttag_text(self) -> str: ...
